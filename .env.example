# Provider-neutral OIDC configuration. No provider is enabled by this example.
# These are server-only bindings/secrets; never use NEXT_PUBLIC_ variables.
SAHA_OIDC_ISSUER=
SAHA_OIDC_CLIENT_ID=
SAHA_OIDC_CLIENT_SECRET=
# Exact registered HTTPS callback, ending /api/auth/callback.
SAHA_OIDC_REDIRECT_URL=
# client_secret_basic (default with secret), client_secret_post, or none (public PKCE client).
SAHA_OIDC_TOKEN_AUTH_METHOD=
# Comma-separated exact trusted app origins, no paths/wildcards. Required for mutations.
SAHA_ALLOWED_ORIGINS=

# Notification settings (providers remain disabled).
SAHA_NOTIFICATION_EMAIL_FROM=

# Database settings (for development)
DB_URL=

# Confirmed external reading app, HTTPS URL without query or fragment. Blank disables launch.
SAHA_ORF_APP_URL=
